# Copy to scripts/deploy.env and fill in values.
# deploy.env is gitignored — never commit secrets.

# --- FTP (InfinityFree) ---
FTP_HOST=ftpupload.net
FTP_USER=if0_42654988
FTP_PASS=CHANGE_ME
FTP_REMOTE_ROOT=/htdocs

# --- App Configuration ---
APP_NAME="WorkForge"
APP_URL=http://yourdomain.infinityfreeapp.com
APP_KEY=base64:CHANGE_ME

# --- Local MySQL (optional: apply migrations on your machine) ---
RUN_LOCAL_DB=0
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3306
LOCAL_DB_NAME=workforge
LOCAL_DB_USER=root
LOCAL_DB_PASS=

# --- Remote MySQL (usually only works FROM the hosting server, not your laptop) ---
RUN_REMOTE_DB=0
REMOTE_DB_HOST=sql301.infinityfree.com
REMOTE_DB_PORT=3306
REMOTE_DB_NAME=if0_42654988_workforge
REMOTE_DB_USER=if0_42654988
REMOTE_DB_PASS=CHANGE_ME

# One-time migration via HTTP installer on the live site.
# Script uploads install.php, calls it, then deletes it.
RUN_REMOTE_INSTALL=0
SITE_URL=http://yourdomain.infinityfreeapp.com
INSTALL_KEY=workforge2026

# --- Build ---
BUILD_FRONTEND=1
SMOKE_TEST=1

# --- Laravel Settings ---
COMPOSER_INSTALL=1
ARTISAN_MIGRATE=1

# Do not overwrite live .env (recommended 1)
KEEP_REMOTE_ENV=1
